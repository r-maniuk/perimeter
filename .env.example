# Optional settings for docker compose. Copy to `.env` and uncomment what you want to change;
# every value below is the default. There are no secrets here: the `secrets` job generates them on
# the first start and keeps them in the `secrets` volume (`make ingest-token` copies the device
# ingest token to .secrets/ for load tests run from the host).
#
# The stack reads this file twice: docker compose substitutes the first group into
# docker-compose.yml, and every Python service receives the whole file as environment variables.

# --- Stack ----------------------------------------------------------------------------------------
# Where the edge listens on the host. 0.0.0.0 exposes it to the local network (e.g. a phone);
# add that origin to ALLOWED_ORIGINS too, or the live channel refuses the browser.
# HTTP_BIND=127.0.0.1
# HTTP_PORT=8080
# ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Tag of the locally built images (perimeter-app, perimeter-db, perimeter-nats, perimeter-edge).
# PERIMETER_TAG=local
# production (JSON logs) or development (readable console logs).
# PERIMETER_ENV=production
# LOG_LEVEL=INFO

# --- Observability (make observe) -----------------------------------------------------------------
# `make observe` points the services at Jaeger; set it here to trace on every start.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_SAMPLE_RATIO=0.01
# PROMETHEUS_PORT=9090
# JAEGER_PORT=16686

# --- Load generator (make load) -------------------------------------------------------------------
# Any generator flag works as GENERATOR_<FLAG>, see `docker compose run --rm generator --help`.
# GENERATOR_DEVICES=10000
# GENERATOR_INTERVAL=3
# GENERATOR_DURATION=300
# GENERATOR_TRANSPORT=http

# --- Sessions -------------------------------------------------------------------------------------
# SESSION_TTL_S=43200
# LOGIN_RATE_PER_MINUTE=20
# Set to true when a TLS proxy terminates HTTPS in front of the edge.
# SECURE_COOKIES=false

# --- Telemetry stream -----------------------------------------------------------------------------
# The partition count is fixed once the stream exists (it decides where each device's reports
# land); change it only together with `make destroy`.
# TELEMETRY_PARTITIONS=16
# TELEMETRY_MAX_AGE_S=7200
# TELEMETRY_MAX_BYTES=2147483648
# TELEMETRY_DEDUP_WINDOW_S=30

# --- Device tracks ---------------------------------------------------------------------------------
# Every applied report is kept this long for device trails, in 10-minute partitions that the engine
# rolls forward and drops whole.
# TRACK_RETENTION_MIN=30
# TRACK_MAINTENANCE_S=60

# --- Ingest and backpressure ----------------------------------------------------------------------
# INGEST_MAX_BATCH=1000
# INGEST_MAX_BODY_BYTES=1048576
# INGEST_MAX_INFLIGHT=20000
# INGEST_MAX_SKEW_S=30
# Shed load (503 + Retry-After, WebSocket credit held) above HIGH pending reports, resume below LOW.
# INGEST_ADMISSION_HIGH=150000
# INGEST_ADMISSION_LOW=50000
# INGEST_ADMISSION_SAMPLE_MS=500
# INGEST_WS_INITIAL_CREDIT=2000

# --- Geofence engine ------------------------------------------------------------------------------
# ENGINE_BATCH_MAX=1000
# ENGINE_FETCH_WAIT_S=1.0
# ENGINE_LEASE_TTL_S=6
# How long a drained partition waits for more reports before the next transaction.
# ENGINE_LINGER_MS=25

# --- Live channel ---------------------------------------------------------------------------------
# LIVE_TILE_ZOOM=12
# LIVE_TILE_FLUSH_MS=100
# LIVE_SEND_TIMEOUT_S=5
# LIVE_EVENT_QUEUE_MAX=1024
# LIVE_POSITION_BUDGET_BYTES=1048576
# LIVE_MAX_SESSIONS_PER_USER=16
# LIVE_MAX_VIEWPORT_TILES=16
# LIVE_DEVICE_STALE_S=600
# LIVE_SNAPSHOT_CACHE_S=1.0

# --- Database and broker clients ------------------------------------------------------------------
# Pool sizes are part of the stack's connection budget (see the db service) and fixed per service.
# DATABASE_POOL_TIMEOUT_S=2.0
# DATABASE_STATEMENT_TIMEOUT_MS=5000
# NATS_CONNECT_TIMEOUT_S=5.0
# NATS_REQUEST_TIMEOUT_S=5.0
