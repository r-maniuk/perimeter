# Edge: the only entry point of the stack. Serves the dashboard's static build, proxies the API
# (HTTP and WebSocket) to however many api replicas are running, and sets the security headers.
# Plain HTTP on :8080; TLS belongs to whatever terminates it in front of this deployment.
{
	admin off
	auto_https off
	persist_config off
	# Let in-flight requests finish on shutdown; live WebSockets reconnect and resume by sequence.
	grace_period 10s
	servers :8080 {
		# Plain HTTP here; HTTP/2 and HTTP/3 belong to whatever terminates TLS in front.
		protocols h1
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 32KB
	}
}

# The api replicas, found through Docker's DNS: every address behind the service name `api`.
# Caddy runs no active health checks for dynamic upstreams, so the list is refreshed often and
# replicas that fail or answer 5xx are taken out of rotation by passive checks; requests that
# cannot reach one replica are retried on another.
(api_upstreams) {
	reverse_proxy {
		dynamic a {
			name api
			port 8000
			refresh 5s
			versions ipv4
		}
		# Long-lived WebSockets make the connection count the right measure of load.
		lb_policy least_conn
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 3
		unhealthy_status 502 503 504
		# Stream every write straight through (ingest acks, live frames).
		flush_interval -1
		transport http {
			dial_timeout 2s
			response_header_timeout 30s
			keepalive 90s
			keepalive_idle_conns_per_host 64
		}
	}
}

(common_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		-Server
		-Via
	}
	# Only meaningful when this server itself terminates TLS.
	@tls protocol https
	header @tls Strict-Transport-Security "max-age=63072000; includeSubDomains"
}

:8080 {
	log {
		output stdout
		format filter {
			wrap json
			# Command-line clients may authenticate the live channel with ?token=.
			request>uri query {
				replace token REDACTED
			}
			request>headers>X-Ingest-Token replace REDACTED
		}
	}

	import common_headers
	encode zstd gzip
	request_body {
		max_size 2MB
	}

	# Prometheus scrapes the replicas directly on the internal network; never through the edge.
	handle /metrics* {
		respond 404
	}

	# FastAPI's interactive API docs load Swagger UI from its CDN and bootstrap it with one inline
	# script. This relaxed policy applies to these two pages only.
	@docs path /docs /docs/*
	handle @docs {
		header Content-Security-Policy "default-src 'none'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		import api_upstreams
	}

	@api path /v1/* /openapi.json /healthz /readyz
	handle @api {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		header ?Cache-Control no-store
		import api_upstreams
	}

	# Everything else is the single-page dashboard.
	handle {
		root * /srv
		# Map tiles, styles and glyphs come from OpenFreeMap; MapLibre renders in blob: workers.
		# Styles allow 'unsafe-inline' because UI primitives inject <style> elements at runtime;
		# scripts never run inline.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self' data:; connect-src 'self' ws://{http.request.hostport} wss://{http.request.hostport} https://tiles.openfreemap.org; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"

		# Content-hashed build output never changes under the same name.
		@hashed path /assets/*
		handle @hashed {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server {
				precompressed br zstd gzip
			}
		}
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server {
				precompressed br zstd gzip
			}
		}
	}

	# No replica reachable (or all shedding): answer API clients in the API's own error format,
	# with a hint to retry, instead of an empty 502.
	handle_errors 502 503 504 {
		@api_error path /v1/* /openapi.json /healthz /readyz
		handle @api_error {
			header Content-Type application/problem+json
			header Retry-After 2
			respond `{"type":"https://perimeter.dev/problems/unavailable","title":"Service Unavailable","status":503,"detail":"no API replica is reachable right now","code":"unavailable"}` 503
		}
	}
}
