# Edge: the only entry point of the stack. Serves the dashboard's static build, proxies the API
# (HTTP and WebSocket) to however many api replicas are running, and sets the security headers.
# Plain HTTP on :8080; TLS belongs to whatever terminates it in front of this deployment.
{
	admin off
	auto_https off
	persist_config off
	# Let in-flight requests finish on shutdown; live WebSockets reconnect and resume by sequence.
	grace_period 10s
	servers :8080 {
		# Plain HTTP here; HTTP/2 and HTTP/3 belong to whatever terminates TLS in front.
		protocols h1
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
		max_header_size 32KB
	}
}

# The api replicas, found through Docker's DNS: every address behind the service name `api`.
# Caddy runs no active health checks for dynamic upstreams, so the list is refreshed often and a
# replica that cannot be reached is taken out of rotation by passive checks; requests that cannot
# reach one replica are retried on another. Only failed connections count: a replica's own 503 is
# deliberate (ingest shedding load, a database that is momentarily unavailable) and taking it out
# of rotation for that would turn load shedding into an outage of the whole API.
(api_upstreams) {
	reverse_proxy {
		dynamic a {
			name api
			port 8000
			refresh 5s
			versions ipv4
		}
		# Long-lived WebSockets make the connection count the right measure of load.
		lb_policy least_conn
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 3
		# Stream every write straight through (ingest acks, live frames).
		flush_interval -1
		transport http {
			dial_timeout 2s
			response_header_timeout 30s
			keepalive 90s
			keepalive_idle_conns_per_host 64
		}
	}
}

(common_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		-Server
		-Via
	}
	# Only meaningful when this server itself terminates TLS (@tls is defined by the site).
	header @tls Strict-Transport-Security "max-age=63072000; includeSubDomains"
}

:8080 {
	log {
		output stdout
		format filter {
			wrap json
			# Tokens are not accepted in URLs; one a client puts there anyway is not logged.
			request>uri query {
				replace token REDACTED
			}
			request>headers>X-Ingest-Token replace REDACTED
		}
	}

	@tls protocol https
	import common_headers
	encode zstd gzip
	request_body {
		max_size 2MB
	}

	# Prometheus scrapes the replicas directly on the internal network; never through the edge.
	handle /metrics* {
		respond 404
	}

	# The interactive API reference: Swagger UI shipped in this image, reading /openapi.json from
	# the API. Scripts come from this origin only; its components set inline styles.
	@docs path /docs /docs/*
	handle @docs {
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		header Cache-Control "no-cache"
		root * /srv
		rewrite /docs /docs/index.html
		file_server
	}

	@api path /v1/* /openapi.json /healthz /readyz
	handle @api {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		header ?Cache-Control no-store
		import api_upstreams
	}

	# Everything else is the single-page dashboard.
	handle {
		root * /srv
		# Map tiles, styles and glyphs come from OpenFreeMap; MapLibre renders in blob: workers.
		# Styles allow 'unsafe-inline' because UI primitives inject <style> elements at runtime;
		# scripts never run inline.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self' data:; connect-src 'self' ws://{http.request.hostport} wss://{http.request.hostport} https://tiles.openfreemap.org; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"

		# Content-hashed build output never changes under the same name.
		@hashed path /assets/*
		handle @hashed {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server {
				precompressed br zstd gzip
			}
		}
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server {
				precompressed br zstd gzip
			}
		}
	}

	# Errors raised by the edge itself (no replica reachable, a file that is not there) leave the
	# routes above, so they get the security headers here. API clients get the API's own error
	# format with a hint to retry, instead of an empty 502; the rest, the status and its name.
	handle_errors {
		import common_headers
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		@api_unavailable {
			path /v1/* /openapi.json /healthz /readyz
			expression `{err.status_code} in [502, 503, 504]`
		}
		handle @api_unavailable {
			header Content-Type application/problem+json
			header Retry-After 2
			respond `{"type":"/problems/unavailable","title":"Service Unavailable","status":503,"detail":"no API replica is reachable right now","code":"unavailable"}` 503
		}
		handle {
			respond "{err.status_code} {err.status_text}" {err.status_code}
		}
	}
}
